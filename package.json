{
  "name": "tbrowse",
  "version": "0.0.0",
  "description": "Embeddable React component for visualizing phylogenetic trees with pluggable data zones.",
  "type": "module",
  "main": "./dist/tbrowse.cjs",
  "module": "./dist/tbrowse.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tbrowse.js",
      "require": "./dist/tbrowse.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.1.5"
  },
  "author": "Andrew Olson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/warelab/tbrowse.git"
  },
  "keywords": [
    "react-component",
    "phylogenetics",
    "tree",
    "msa",
    "bioinformatics"
  ]
}
