{
  "name": "tbrowse",
  "version": "2.11.0",
  "description": "Embeddable React component for visualizing phylogenetic trees and pluggable data zones.",
  "type": "module",
  "main": "./dist/tbrowse.cjs",
  "module": "./dist/tbrowse.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tbrowse.js",
      "require": "./dist/tbrowse.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:core": "npm run build -w packages/core",
    "prebuild": "npm run build:core",
    "build:playground": "vite build --mode playground",
    "preview:playground": "vite preview --mode playground",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run build:core",
    "typecheck:playground": "tsc -p examples/playground/tsconfig.json --noEmit",
    "check:exports": "node scripts/check-exports.mjs",
    "prepublishOnly": "rm -rf dist && node scripts/check-core-published.mjs && npm run build && npm run typecheck && npm test && npm run check:exports",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "vitest run && npm test -w packages/core",
    "test:watch": "vitest",
    "release:core": "npm publish -w packages/core"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "tbrowse-core": ">=0.1.0 <2.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.1.5"
  },
  "author": "Andrew Olson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/warelab/tbrowse.git"
  },
  "keywords": [
    "react-component",
    "phylogenetics",
    "tree",
    "msa",
    "bioinformatics"
  ],
  "workspaces": [
    "packages/*"
  ]
}
